# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Public URL for uploaded media (must match your deployed API host, NOT localhost in production)
BASE_URL=http://localhost:4000
# Production example: BASE_URL=https://triumphant-bravery-production-4779.up.railway.app

# PostgreSQL — local dev (individual vars)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zyntraplus
DB_USER=postgres
DB_PASSWORD=database@123
DB_SSL=false
DB_POOL_MAX=10

# Railway / cloud — use Postgres plugin URL instead of DB_* above:
# DATABASE_URL=postgresql://user:pass@host:port/railway
# (Railway auto-injects when you link Postgres → Reference Variable)

# Docker only (ignored when using local PostgreSQL service)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
# POSTGRES_DB=zyntraplus

# JWT
JWT_SECRET=change-this-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# OAuth (comma-separated client IDs — optional but recommended in production)
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# APPLE_CLIENT_ID=com.yourcompany.zyntraplus

# CORS (comma-separated origins, or leave empty for all)
# CORS_ORIGIN=http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=40

# Uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=50

# Socket.IO
SOCKET_PATH=/socket.io

# Redis (optional — speeds up feed/suggestions/chat lists; in-memory fallback if unset)
# REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=zp:
# CACHE_FEED_TTL_SECONDS=45
# CACHE_SUGGESTIONS_TTL_SECONDS=120
# CACHE_CONVERSATIONS_TTL_SECONDS=30
# CACHE_PROFILE_TTL_SECONDS=180

# Mock OTP (dev) — replace with real SMS/email later
MOCK_OTP_ENABLED=true
MOCK_OTP_CODE=123456
OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5

# Tips — in-app credits (not real money). New users start with 500 credits.
# TIP_STARTING_CREDITS=500

# Firebase Cloud Messaging (FCM) — required for push notifications
# Get service account JSON from Firebase Console → Project Settings → Service Accounts
# Either paste the entire JSON as a string (recommended for Railway/cloud):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Or provide a file path (for local dev):
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
